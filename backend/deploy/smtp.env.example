# Copy to /etc/bilingual-account/smtp.env on the server, mode 0600.
# Replace placeholders locally; never put real credentials in this repository.
IME_SMTP_HOST=smtp.example.com
IME_SMTP_PORT=587
IME_SMTP_MODE=starttls
IME_SMTP_USER=sender@example.com
IME_SMTP_PASSWORD=REPLACE_ON_SERVER
IME_MAIL_FROM=sender@example.com
